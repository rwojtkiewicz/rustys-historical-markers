        }
        lines {
          text: "    id: \'marker-meramec-caverns\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Meramec Caverns - Jesse James Hideout\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subtitle: \'Historic Ozark Cave System Along Route 66\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Carved from limestone over 400 million years, these 4.6-mile Ozark caverns served as a saltpeter magazine during the Civil War and a legendary hideout for outlaw Jesse James and the James-Younger Gang in the 1870s. In 1935, Lester Dill opened it as a pioneer attraction along Route 66.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Outlaw & Lore\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
