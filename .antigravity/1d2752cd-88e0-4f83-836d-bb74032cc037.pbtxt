          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The signal lanterns warned patriot couriers across the river, allowing Revere and Dawes to mount their famous midnight rides to alert countryside militias.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
