          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        url: \'https://images.unsplash.com/photo-1555881400-74d7acaacd8b?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        caption: \'Mount Vernon Mansion Lawn Facing the Potomac\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
