        }
        lines {
          text: "    subtitle: \'19th Century Appalachian Mountain Settlement\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'This mountain farm museum showcases authentic log structures constructed by 19th-century Appalachian settlers. Living off rugged ridge terrain, these self-sufficient families developed distinctive craftsmanship, music, and agricultural traditions preserved along the Parkway.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
