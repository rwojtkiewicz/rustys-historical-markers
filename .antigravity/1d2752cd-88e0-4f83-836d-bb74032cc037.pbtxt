        lines {
          text: "    id: \'marker-ted-drewes\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Ted Drewes Frozen Custard - Route 66\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subtitle: \'St. Louis Route 66 Landmark Since 1929\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Serving its famous \"concrete\" milkshakes upside down since the 1930s, Ted Drewes on Chippewa Street became an essential pit-stop for generations of Route 66 road-trippers entering Missouri. Founded by Ted Drewes Sr., the stand remains a world-renowned roadside icon.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
