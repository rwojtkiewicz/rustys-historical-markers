        }
        lines {
          text: "    title: \'Harry S. Truman National Historic Site\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subtitle: \'Home of the 33rd President of the United States\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'This Victorian residence in Independence served as the home of President Harry S. Truman and First Lady Bess Wallace Truman. Known as the \"Summer White House\" during his presidency (1945-1953), Truman made monumental decisions here including the Marshall Plan and NATO creation.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
