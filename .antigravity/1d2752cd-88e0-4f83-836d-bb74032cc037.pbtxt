2:   setFrameMode,\n13:   children,\n14: }) => {\n15:   const [timeStr, setTimeStr] = useState(\'12:00\');\n16: \n17:   useEffect(() => {\n18:     const updateTime = () => {\n19:       const now = new Date();\n20:       setTimeStr(\n21:         now.toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', hour12: false })\n22:       );\n23:     };\n24:     updateTime();\n25:     const interval = setInterval(updateTime, 10000);\n26:     return () => clearInterval(interval);\n27:   }, []);\n28: \n29:   if (frameMode === \'fullscreen\') {\n30:     return (\n31:       <div className=\"w-full h-screen bg-slate-950 text-slate-100 flex flex-col relative overflow-hidden font-sans\">\n32:         {/* Top Control Bar for Frame Switch */}\n33:         <div className=\"bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center justify-between z-30 text-xs\">\n34:           <div className=\"flex items-center gap-2\">\n35:             <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\"></span>\n36:             <span className=\"font-semibold text-amber-400 uppercase tracking-wider\">HistoriDrive GPS</span>\n37:             <span className=\"text-slate-400 font-mono hidden sm:inline\">| Driving Alert & Audio Tour</span>\n38:           </div>\n39: \n40:           <div className=\"flex items-center gap-2 bg-slate-800/80 p-1 rounded-lg border border-slate-700\">\n41:             <button\n42:               onClick={() => setFrameMode(\'iphone\')}\n43:               className={`flex items-center gap-1 px-2 py-1 rounded text-xs transition ${\n44:                 frameMode === \'iphone\'\n45:                   ? \'bg-amber-500 text-slate-950 font-medium shadow\'\n46:                   : \'text-slate-300 hover:text-white\'\n47:               }`}\n48:               title=\"iPhone Preview\"\n49:             >\n50:               <Smartphone className=\"w-3.5 h-3.5\" />\n51:               <span>iPhone</span>\n52:             </button>\n53:             <button\n5