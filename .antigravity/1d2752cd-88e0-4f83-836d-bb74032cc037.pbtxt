          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'George Washington expanded this 8,000-acre plantation overlooking the Potomac River into his cherished home. The 10-room mansion with its iconic two-story piazza witnessed the planning of Washington\\\'s military campaigns and retirement after serving as General and First President.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
