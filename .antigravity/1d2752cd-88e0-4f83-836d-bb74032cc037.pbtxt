          text: "    historicalContext:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Route 66 served as a primary route for those who migrated west, especially during the Dust Bowl of the 1930s, and supported the economies of the communities through which the road passed.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
