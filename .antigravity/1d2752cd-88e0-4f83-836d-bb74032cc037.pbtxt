        }
        lines {
          text: "      {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        url: \'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
