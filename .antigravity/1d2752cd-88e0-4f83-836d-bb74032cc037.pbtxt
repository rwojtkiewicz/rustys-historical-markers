        lines {
          text: "        url: \'https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
