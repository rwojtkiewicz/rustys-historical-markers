          text: "    title: \'George Washington\\\'s Mount Vernon Estate\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    subtitle: \'Home of the First President\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
