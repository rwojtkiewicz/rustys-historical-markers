          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    photos: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        url: \'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        caption: \'The Minute Man Monument on Lexington Battle Green\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
