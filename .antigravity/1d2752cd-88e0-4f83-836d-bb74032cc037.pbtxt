          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Founded in 1770 by Father Jun\303\255pero Serra, Carmel Mission served as the administrative headquarters for California\\\'s 21 Spanish missions. Built from local sandstone with a distinctive star-shaped window, Father Serra is interred beneath the sanctuary floor.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
