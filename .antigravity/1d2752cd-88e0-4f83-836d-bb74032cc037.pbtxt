        lines {
          text: "    title: \'Historic Route 66 Original Begin Marker\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'The Mother Road Starting Point\',"
