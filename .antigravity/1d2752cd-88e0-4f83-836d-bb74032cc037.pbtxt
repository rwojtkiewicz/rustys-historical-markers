    replacement_chunks {
      replacement_content: "import { HistoricalMarker, DrivingRoute } from \'../types\';\n\nexport const HISTORICAL_MARKERS: HistoricalMarker[] = [\n  // Freedom Trail & Route 2 (MA)\n  {\n    id: \'marker-lexington-green\',\n    title: \'Lexington Battle Green\',\n    subtitle: \'The Opening Shots of the American Revolution\',\n    plaqueText:\n      \'On April 19, 1775, eight Captain John Parker minutemen fell on this village green in the first clash of arms of the American Revolutionary War. Captain Parker commanded: \"Stand your ground; don\\\'t fire unless fired upon, but if they mean to have a war, let it begin here!\"\',\n    category: \'Revolutionary War\',\n    era: \'1775\',\n    lat: 42.4491,\n    lng: -71.2294,\n    locationName: \'Lexington Battle Green\',\n    city: \'Lexington\',\n    state: \'MA\',\n    yearErected: 1899,\n    markerNumber: \'MA-REV-01\',\n    routeIds: [\'route-freedom-trail\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'The Minute Man Monument on Lexington Battle Green\',\n        credit: \'National Park Service\',\n        isPlaquePhoto: false,\n      },\n      {\n        url: \'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Bronze Memorial Plaque commemorating the Fallen Patriots\',\n        isPlaquePhoto: true,\n      },\n    ],\n    historicalContext:\n      \'The Battle of Lexington was the first military engagement of the American Revolutionary War. Seventy-seven minutemen confronted 700 British regulars on the green.\',\n  },\n  {\n    id: \'marker-old-north-church\',\n    title: \'Old North Church & Paul Revere Lanterns\',\n    subtitle: \'One if by Land, Two if by Sea\',\n    plaqueText:\n      \'From the steeple of this church, built in 1723, on the night of April 18, 1775, two lanterns were displayed as a signal to Paul Revere that the British troops were advancing to Concord by water across the Charles River.\',\n    category: \'Revolutionary War\',\n    era: \'1775\',\n    lat: 42.3663,\n    lng: -71.0544,\n    locationName: \'193 Salem Street\',\n    city: \'Boston\',\n    state: \'MA\',\n    yearErected: 1923,\n    markerNumber: \'MA-REV-02\',\n    routeIds: [\'route-freedom-trail\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1569974498991-d3c12a504f9c?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Steeple of Christ Church (Old North)\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'The signal lanterns warned patriot couriers across the river, allowing Revere and Dawes to mount their famous midnight rides to alert countryside militias.\',\n  },\n  {\n    id: \'marker-concord-old-north-bridge\',\n    title: \'Concord Old North Bridge\',\n    subtitle: \'The Shot Heard \\\'Round the World\',\n    plaqueText:\n      \'By the rude bridge that arched the flood, their flag to April\\\'s breeze unfurled, here once the embattled farmers stood and fired the shot heard round the world. Here colonial militia repulsed British troops at the Concord River on April 19, 1775.\',\n    category: \'Revolutionary War\',\n    era: \'1775\',\n    lat: 42.4692,\n    lng: -71.3508,\n    locationName: \'Minuteman National Historical Park\',\n    city: \'Concord\',\n    state: \'MA\',\n    yearErected: 1836,\n    markerNumber: \'MA-REV-03\',\n    routeIds: [\'route-freedom-trail\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Reconstructed Old North Bridge in Concord\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'This marked the first time American militia officers ordered their men to fire directly upon soldier representatives of the British Crown.\',\n  },\n\n  // Route 66 Stretch (IL -> MO)\n  {\n    id: \'marker-route66-begin\',\n    title: \'Historic Route 66 Original Begin Marker\',\n    subtitle: \'The Mother Road Starting Point\',\n    plaqueText:\n      \'Here at Adams Street & Michigan Avenue in downtown Chicago began U.S. Route 66 on November 11, 1926. Stretching 2,448 miles across eight states to Santa Monica, California, Route 66 became the main artery of Westward migration and American road culture.\',\n    category: \'Aviation & Transit\',\n    era: \'1926\',\n    lat: 41.8795,\n    lng: -87.6243,\n    locationName: \'Adams St & Michigan Ave\',\n    city: \'Chicago\',\n    state: \'IL\',\n    yearErected: 1999,\n    markerNumber: \'IL-R66-01\',\n    routeIds: [\'route-66-mother-road\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Route 66 Begin Shield Sign\',\n        isPlaquePhoto: true,\n      },\n    ],\n    historicalContext:\n      \'Route 66 served as a primary route for those who migrated west, especially during the Dust Bowl of the 1930s, and supported the economies of the communities through which the road passed.\',\n  },\n  {\n    id: \'marker-lincoln-tomb\',\n    title: \'Abraham Lincoln Tomb & Homestead\',\n    subtitle: \'Now He Belongs to the Ages\',\n    plaqueText:\n      \'In this granite obelisk monument rests Abraham Lincoln, 16th President of the United States. Following his assassination in April 1865, his funeral train traveled 1,654 miles across eight states before returning him to his home city of Springfield.\',\n    category: \'Notable Figures\',\n    era: \'1865\',\n    lat: 39.8219,\n    lng: -89.6575,\n    locationName: \'Oak Ridge Cemetery\',\n    city: \'Springfield\',\n    state: \'IL\',\n    yearErected: 1874,\n    markerNumber: \'IL-LINCOLN-04\',\n    routeIds: [\'route-66-mother-road\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1541872703-74c5e44368f9?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Lincoln Monument Spire and Bronze Statue\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Designed by sculptor Larkin Goldsmith Mead, the tomb is constructed of Massachusetts granite and features a 117-foot spire.\',\n  },\n  {\n    id: \'marker-chain-of-rocks\',\n    title: \'Historic Chain of Rocks Bridge\',\n    subtitle: \'The 22-Degree Turn Over the Mississippi\',\n    plaqueText:\n      \'Opened in 1929, this iconic 5,353-foot bridge carried Route 66 traffic over the Mississippi River. Famous for its unique 22-degree bend in the middle, engineered to allow river barges safe passage through treacherous bedrock rapids below.\',\n    category: \'Architecture\',\n    era: \'1929\',\n    lat: 38.7611,\n    lng: -90.1764,\n    locationName: \'Chain of Rocks Road\',\n    city: \'St. Louis\',\n    state: \'MO\',\n    yearErected: 1996,\n    markerNumber: \'MO-R66-02\',\n    routeIds: [\'route-66-mother-road\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Truss Bridge spanning the Mississippi\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'The bridge was a key landmark for Route 66 travelers crossing between Illinois and Missouri for nearly four decades.\',\n  },\n\n  // Blue Ridge Parkway & Colonial Virginia\n  {\n    id: \'marker-humpback-rocks\',\n    title: \'Humpback Rocks Pioneer Farmstead\',\n    subtitle: \'19th Century Appalachian Mountain Settlement\',\n    plaqueText:\n      \'This mountain farm museum showcases authentic log structures constructed by 19th-century Appalachian settlers. Living off rugged ridge terrain, these self-sufficient families developed distinctive craftsmanship, music, and agricultural traditions preserved along the Parkway.\',\n    category: \'Pioneer & Trails\',\n    era: \'1850s\',\n    lat: 37.9683,\n    lng: -78.8988,\n    locationName: \'Milepost 5.8 Blue Ridge Pkwy\',\n    city: \'Lyndhurst\',\n    state: \'VA\',\n    yearErected: 1955,\n    markerNumber: \'BRP-05\',\n    routeIds: [\'route-blue-ridge\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Log Cabin at Humpback Rocks\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Log homes were built using native chestnut logs notched tightly together, surrounded by split-rail fences and mountain vegetable gardens.\',\n  },\n  {\n    id: \'marker-peaks-of-otter\',\n    title: \'Peaks of Otter Historic Vista\',\n    subtitle: \'Natural Waypoint of Native Tribes and Early Surveyors\',\n    plaqueText:\n      \'Rising abruptly over the Shenandoah Valley, these twin mountain peaks served as navigation beacons for Monacan Native Americans for over 8,000 years, and later marked Thomas Jefferson\\\'s favorite Blue Ridge mountain view in his 1781 Notes on the State of Virginia.\',\n    category: \'Indigenous History\',\n    era: \'1781\',\n    lat: 37.4474,\n    lng: -79.6083,\n    locationName: \'Milepost 86 Blue Ridge Pkwy\',\n    city: \'Bedford\',\n    state: \'VA\',\n    yearErected: 1938,\n    markerNumber: \'BRP-86\',\n    routeIds: [\'route-blue-ridge\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Peaks of Otter Overlook at Sunset\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'A stone from Sharp Top peak was carried to Washington D.C. in 1852 to represent Virginia in the construction of the Washington Monument.\',\n  },\n  {\n    id: \'marker-mabry-mill\',\n    title: \'Mabry Mill Historic Watermill\',\n    subtitle: \'The Heart of Blue Ridge Heritage\',\n    plaqueText:\n      \'Built between 1903 and 1914 by Ed Mabry, this gristmill, sawmill, and blacksmith shop served as the community gathering place for mountain residents for decades. The overshot waterwheel remains powered by native streamflow.\',\n    category: \'Science & Industry\',\n    era: \'1903\',\n    lat: 36.7501,\n    lng: -80.4022,\n    locationName: \'Milepost 176.1 Blue Ridge Pkwy\',\n    city: \'Meadows of Dan\',\n    state: \'VA\',\n    yearErected: 1942,\n    markerNumber: \'BRP-176\',\n    routeIds: [\'route-blue-ridge\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Wooden Waterwheel at Mabry Mill\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Mabry Mill is widely considered the most photographed location along the entire 469-mile Blue Ridge Parkway.\',\n  },\n\n  // Historic Highway 101 & Big Sur Coast (CA)\n  {\n    id: \'marker-bixby-bridge\',\n    title: \'Bixby Creek Bridge Landmark\',\n    subtitle: \'Engineering Triumph of the Pacific Coast Highway\',\n    plaqueText:\n      \'Completed in 1932 for $200,000, this open-spandrel concrete arch bridge spans 320 feet across Bixby Canyon, 260 feet above the crashing Pacific surf. Built during the Great Depression by the Civilian Conservation Corps, it opened the isolated Big Sur coastline to the world.\',\n    category: \'Architecture\',\n    era: \'1932\',\n    lat: 36.3714,\n    lng: -121.9017,\n    locationName: \'Highway 1 Milepost 60\',\n    city: \'Big Sur\',\n    state: \'CA\',\n    yearErected: 1968,\n    markerNumber: \'CA-HWY1-12\',\n    routeIds: [\'route-pacific-coast\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1506146332389-18140dc7b2fb?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Bixby Bridge Coastal Vista\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Prior to the bridge opening in 1932, residents of Big Sur were often cut off during winter storms on the narrow interior dirt roads.\',\n  },\n  {\n    id: \'marker-mission-carmel\',\n    title: \'Mission San Carlos Borromeo de Carmelo\',\n    subtitle: \'Headquarters of the California Mission Chain\',\n    plaqueText:\n      \'Founded in 1770 by Father Jun\303\255pero Serra, Carmel Mission served as the administrative headquarters for California\\\'s 21 Spanish missions. Built from local sandstone with a distinctive star-shaped window, Father Serra is interred beneath the sanctuary floor.\',\n    category: \'Architecture\',\n    era: \'1770\',\n    lat: 36.5428,\n    lng: -121.9189,\n    locationName: \'3080 Rio Road\',\n    city: \'Carmel-by-the-Sea\',\n    state: \'CA\',\n    yearErected: 1933,\n    markerNumber: \'CA-CHL-135\',\n    routeIds: [\'route-pacific-coast\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1548625361-18da3a16bf15?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Stone Courtyard and Courtyard Tower of Carmel Mission\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Designated a National Historic Landmark in 1960, it retains its original 1790s sandstone basilica architecture.\',\n  },\n  {\n    id: \'marker-hearst-castle\',\n    title: \'Hearst San Simeon Estate\',\n    subtitle: \'La Cuesta Encantada - The Enchanted Hill\',\n    plaqueText:\n      \'Designed by pioneering architect Julia Morgan between 1919 and 1947 for publisher William Randolph Hearst. Combining Spanish Cathedral, Mediterranean Revival, and classical European treasures, this 127-acre estate hosted World leaders, Hollywood legends, and literary icons.\',\n    category: \'Architecture\',\n    era: \'1919\',\n    lat: 35.6852,\n    lng: -121.1682,\n    locationName: \'750 Hearst Castle Rd\',\n    city: \'San Simeon\',\n    state: \'CA\',\n    yearErected: 1958,\n    markerNumber: \'CA-CHL-724\',\n    routeIds: [\'route-pacific-coast\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Neoclassical Neptune Pool at Hearst Castle\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Julia Morgan was the first woman admitted to the architecture program at the \303\211cole des Beaux-Arts in Paris and the first licensed female architect in California.\',\n  },\n\n  // Historic Route 1 & Colonial Potomac Highway (D.C. -> VA)\n  {\n    id: \'marker-mount-vernon\',\n    title: \'George Washington\\\'s Mount Vernon Estate\',\n    subtitle: \'Home of the First President\',\n    plaqueText:\n      \'George Washington expanded this 8,000-acre plantation overlooking the Potomac River into his cherished home. The 10-room mansion with its iconic two-story piazza witnessed the planning of Washington\\\'s military campaigns and retirement after serving as General and First President.\',\n    category: \'Notable Figures\',\n    era: \'1754\',\n    lat: 38.7081,\n    lng: -77.0861,\n    locationName: \'3200 Mount Vernon Memorial Hwy\',\n    city: \'Mount Vernon\',\n    state: \'VA\',\n    yearErected: 1928,\n    markerNumber: \'VA-E-01\',\n    routeIds: [\'route-colonial-virginia\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1555881400-74d7acaacd8b?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Mount Vernon Mansion Lawn Facing the Potomac\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Washington took personal care in designing the agricultural features, flower gardens, and river views of Mount Vernon.\',\n  },\n  {\n    id: \'marker-fredericksburg-battle\',\n    title: \'Battle of Fredericksburg - Sunken Road\',\n    subtitle: \'The Battle of Marye\\\'s Heights\',\n    plaqueText:\n      \'On December 13, 1862, General Robert E. Lee\\\'s Confederate Army of Northern Virginia held the stone wall along this Sunken Road against 14 successive Union assaults. General Lee remarked from the hill above: \"It is well that war is so terrible, or we should grow too fond of it.\"\',\n    category: \'Civil War\',\n    era: \'1862\',\n    lat: 38.2978,\n    lng: -77.4703,\n    locationName: \'Fredericksburg Battlefield Center\',\n    city: \'Fredericksburg\',\n    state: \'VA\',\n    yearErected: 1927,\n    markerNumber: \'VA-E-22\',\n    routeIds: [\'route-colonial-virginia\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Historic Stone Wall along the Sunken Road\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'The Union army suffered over 12,000 casualties during the charges across open ground toward Marye\\\'s Heights.\',\n  },\n  {\n    id: \'marker-historic-williamsburg\',\n    title: \'Colonial Williamsburg Capital Marker\',\n    subtitle: \'Capital of Virginia Colony 1699-1780\',\n    plaqueText:\n      \'Here in the colonial capital of Virginia, Thomas Jefferson, Patrick Henry, and George Mason debated religious freedom, human rights, and independence. Patrick Henry delivered his fiery \"If this be treason, make the most of it!\" speech in the House of Burgesses in 1765.\',\n    category: \'Revolutionary War\',\n    era: \'1699\',\n    lat: 37.2707,\n    lng: -76.7075,\n    locationName: \'Duke of Gloucester Street\',\n    city: \'Williamsburg\',\n    state: \'VA\',\n    yearErected: 1932,\n    markerNumber: \'VA-E-100\',\n    routeIds: [\'route-colonial-virginia\'],\n    photos: [\n      {\n        url: \'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80\',\n        caption: \'Reconstructed Capitol Building in Historic Williamsburg\',\n        isPlaquePhoto: false,\n      },\n    ],\n    historicalContext:\n      \'Williamsburg was the political center of Virginia during the Revolution until the capital moved inland to Richmond in 1780 to avoid British naval raids.\',\n  },\n];\n\nexport const PRESET_ROUTES: DrivingRoute[] = [\n  {\n    id: \'route-freedom-trail\',\n    name: \'Paul Revere & Minuteman Trail\',\n    subtitle: \'Boston to Concord Historic Byway (Route 2)\',\n    description:\n      \'Trace the iconic 1775 route of Paul Revere\\\'s midnight ride and the opening shots of the American Revolution across Boston, Lexington, and Concord.\',\n    region: \'New England (Massachusetts)\',\n    distanceMiles: 24.5,\n    approxDriveTimeHours: 0.8,\n    coverPhoto: \'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1200&q=80\',\n    startPoint: { name: \'Old North Church, Boston\', lat: 42.3663, lng: -71.0544 },\n    endPoint: { name: \'Old North Bridge, Concord\', lat: 42.4692, lng: -71.3508 },\n    waypoints: [\n      { lat: 42.3663, lng: -71.0544, label: \'Old North Church\' },\n      { lat: 42.3736, lng: -71.1097, label: \'Cambridge Common\' },\n      { lat: 42.4153, lng: -71.1565, label: \'Arlington Historical House\' },\n      { lat: 42.4491, lng: -71.2294, label: \'Lexington Battle Green\' },\n      { lat: 42.4589, lng: -71.2911, label: \'Minuteman Visitor Center\' },\n      { lat: 42.4692, lng: -71.3508, label: \'Old North Bridge Concord\' },\n    ],\n    bounds: {\n      north: 42.50,\n      south: 42.30,\n      east: -71.00,\n      west: -71.40,\n    },\n    markerIds: [\'marker-old-north-church\', \'marker-lexington-green\', \'marker-concord-old-north-bridge\'],\n  },\n  {\n    id: \'route-66-mother-road\',\n    name: \'Route 66 Heritage Highway\',\n    subtitle: \'Chicago to St. Louis Historic Highway\',\n    description:\n      \'Drive the legendary mother road through America\\\'s heartland, passing Lincoln\\\'s homestead, historic neon diners, and iconic Mississippi River bridges.\',\n    region: \'Midwest (Illinois & Missouri)\',\n    distanceMiles: 298.0,\n    approxDriveTimeHours: 4.5,\n    coverPhoto: \'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80\',\n    startPoint: { name: \'Route 66 Begin, Chicago\', lat: 41.8795, lng: -87.6243 },\n    endPoint: { name: \'Chain of Rocks Bridge, St. Louis\', lat: 38.7611, lng: -90.1764 },\n    waypoints: [\n      { lat: 41.8795, lng: -87.6243, label: \'Chicago Begin Marker\' },\n      { lat: 41.525, lng: -88.0817, label: \'Joliet Prison Route 66 Park\' },\n      { lat: 40.4842, lng: -88.9937, label: \'Bloomington Normal Station\' },\n      { lat: 39.8219, lng: -89.6575, label: \'Lincoln Tomb Springfield\' },\n      { lat: 39.1812, lng: -89.8456, label: \'Litchfield Ariston Cafe\' },\n      { lat: 38.7611, lng: -90.1764, label: \'Chain of Rocks Bridge\' },\n    ],\n    bounds: {\n      north: 42.00,\n      south: 38.50,\n      east: -87.50,\n      west: -90.30,\n    },\n    markerIds: [\'marker-route66-begin\', \'marker-lincoln-tomb\', \'marker-chain-of-rocks\'],\n  },\n  {\n    id: \'route-blue-ridge\',\n    name: \'Blue Ridge Parkway Scenic Byway\',\n    subtitle: \'Shenandoah Valley to Roanoke Heritage Trail\',\n    plaqueText: \'\',\n    description:\n      \'America\\\'s Favorite Drive winding along the Appalachian crest with 19th-century log homesteads, pioneer watermills, and Native American vistas.\',\n    region: \'Mid-Atlantic (Virginia)\',\n    distanceMiles: 176.0,\n    approxDriveTimeHours: 3.5,\n    coverPhoto: \'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80\',\n    startPoint: { name: \'Waynesboro Entrance MP 0\', lat: 38.0311, lng: -78.8572 },\n    endPoint: { name: \'Mabry Mill MP 176\', lat: 36.7501, lng: -80.4022 },\n    waypoints: [\n      { lat: 38.0311, lng: -78.8572, label: \'Parkway Northern Entrance\' },\n      { lat: 37.9683, lng: -78.8988, label: \'Humpback Rocks Pioneer Farm\' },\n      { lat: 37.7122, lng: -79.2215, label: \'Otter Creek Overlook\' },\n      { lat: 37.4474, lng: -79.6083, label: \'Peaks of Otter Vista\' },\n      { lat: 37.2415, lng: -79.9231, label: \'Roanoke Valley Overlook\' },\n      { lat: 36.7501, lng: -80.4022, label: \'Mabry Mill Waterwheel\' },\n    ],\n    bounds: {\n      north: 38.20,\n      south: 36.60,\n      east: -78.50,\n      west: -80.60,\n    },\n    markerIds: [\'marker-humpback-rocks\', \'marker-peaks-of-otter\', \'marker-mabry-mill\'],\n  },\n  {\n    id: \'route-pacific-coast\',\n    name: \'Big Sur Pacific Coast Highway 1\',\n    subtitle: \'Carmel to Hearst Castle Coastal Parkway\',\n    description:\n      \'Marvel at dramatic ocean cliffs, historic Spanish missions, depression-era engineering wonders, and cliffside castles along California Highway 1.\',\n    region: \'West Coast (California)\',\n    distanceMiles: 92.0,\n    approxDriveTimeHours: 2.2,\n    coverPhoto: \'https://images.unsplash.com/photo-1506146332389-18140dc7b2fb?auto=format&fit=crop&w=1200&q=80\',\n    startPoint: { name: \'Carmel-by-the-Sea\', lat: 36.5428, lng: -121.9189 },\n    endPoint: { name: \'Hearst Castle San Simeon\', lat: 35.6852, lng: -121.1682 },\n    waypoints: [\n      { lat: 36.5428, lng: -121.9189, label: \'Mission Carmel\' },\n      { lat: 36.3714, lng: -121.9017, label: \'Bixby Creek Bridge\' },\n      { lat: 36.2704, lng: -121.8081, label: \'Point Sur Lighthouse\' },\n      { lat: 36.0822, lng: -121.6012, label: \'Nepenthe Vista Point\' },\n      { lat: 35.6852, lng: -121.1682, label: \'Hearst Castle San Simeon\' },\n    ],\n    bounds: {\n      north: 36.70,\n      south: 35.50,\n      east: -121.00,\n      west: -122.10,\n    },\n    markerIds: [\'marker-mission-carmel\', \'marker-bixby-bridge\', \'marker-hearst-castle\'],\n  },\n  {\n    id: \'route-colonial-virginia\',\n    name: \'Colonial Potomac & Virginia Highway\',\n    subtitle: \'Mount Vernon to Historic Williamsburg\',\n    description:\n      \'Travel the footsteps of the Founding Fathers from Washington\\\'s riverfront estate past Civil War battlefields down to colonial Williamsburg.\',\n    region: \'Mid-Atlantic (Virginia)\',\n    distanceMiles: 142.0,\n    approxDriveTimeHours: 2.5,\n    coverPhoto: \'https://images.unsplash.com/photo-1555881400-74d7acaacd8b?auto=format&fit=crop&w=1200&q=80\',\n    startPoint: { name: \'Mount Vernon Estate\', lat: 38.7081, lng: -77.0861 },\n    endPoint: { name: \'Colonial Williamsburg\', lat: 37.2707, lng: -76.7075 },\n    waypoints: [\n      { lat: 38.7081, lng: -77.0861, label: \'Mount Vernon Estate\' },\n      { lat: 38.5321, lng: -77.3012, label: \'Quantico Marine Historic Park\' },\n      { lat: 38.2978, lng: -77.4703, label: \'Fredericksburg Sunken Road\' },\n      { lat: 37.5407, lng: -77.4360, label: \'Richmond Capitol Square\' },\n      { lat: 37.2707, lng: -76.7075, label: \'Colonial Williamsburg\' },\n    ],\n    bounds: {\n      north: 38.80,\n      south: 37.10,\n      east: -76.50,\n      west: -77.60,\n    },\n    markerIds: [\'marker-mount-vernon\', \'marker-fredericksburg-battle\', \'marker-historic-williamsburg\'],\n  },\n];\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { HistoricalMarker, DrivingRoute } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const HISTORICAL_MARKERS: HistoricalMarker[] = ["
