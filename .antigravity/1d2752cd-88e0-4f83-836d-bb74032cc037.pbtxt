        }
        lines {
          text: "    id: \'marker-fredericksburg-battle\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \'Battle of Fredericksburg - Sunken Road\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'The Battle of Marye\\\'s Heights\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'On December 13, 1862, General Robert E. Lee\\\'s Confederate Army of Northern Virginia held the stone wall along this Sunken Road against 14 successive Union assaults. General Lee remarked from the hill above: \"It is well that war is so terrible, or we should grow too fond of it.\"\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    category: \'Civil War\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    era: \'1862\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lat: 38.2978,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    lng: -77.4703,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
