        lines {
          text: "    id: \'marker-lincoln-tomb\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \'Abraham Lincoln Tomb & Homestead\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'Now He Belongs to the Ages\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'In this granite obelisk monument rests Abraham Lincoln, 16th President of the United States. Following his assassination in April 1865, his funeral train traveled 1,654 miles across eight states before returning him to his home city of Springfield.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    category: \'Notable Figures\',"
