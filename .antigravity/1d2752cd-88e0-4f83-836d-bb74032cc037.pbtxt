        }
        lines {
          text: "    title: \'Concord Old North Bridge\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'The Shot Heard \\\'Round the World\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'By the rude bridge that arched the flood, their flag to April\\\'s breeze unfurled, here once the embattled farmers stood and fired the shot heard round the world. Here colonial militia repulsed British troops at the Concord River on April 19, 1775.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
