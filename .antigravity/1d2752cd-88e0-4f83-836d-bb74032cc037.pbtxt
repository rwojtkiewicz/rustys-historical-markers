        lines {
          text: "    historicalContext:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'The Union army suffered over 12,000 casualties during the charges across open ground toward Marye\\\'s Heights.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
