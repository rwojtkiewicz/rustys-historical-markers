        lines {
          text: "    id: \'marker-historic-williamsburg\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \'Colonial Williamsburg Capital Marker\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'Capital of Virginia Colony 1699-1780\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Here in the colonial capital of Virginia, Thomas Jefferson, Patrick Henry, and George Mason debated religious freedom, human rights, and independence. Patrick Henry delivered his fiery \"If this be treason, make the most of it!\" speech in the House of Burgesses in 1765.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    category: \'Revolutionary War\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
