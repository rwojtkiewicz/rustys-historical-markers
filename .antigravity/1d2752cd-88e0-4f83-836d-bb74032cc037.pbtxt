          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'marker-lexington-green\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Lexington Battle Green\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subtitle: \'The Opening Shots of the American Revolution\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'On April 19, 1775, eight Captain John Parker minutemen fell on this village green in the first clash of arms of the American Revolutionary War. Captain Parker commanded: \"Stand your ground; don\\\'t fire unless fired upon, but if they mean to have a war, let it begin here!\"\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Revolutionary War\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    era: \'1775\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
