        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      \'On December 13, 1862, General Robert E. Lee\\\'s Confederate Army of Northern Virginia held the stone wall along this Sunken Road against 14 successive Union assaults. General Lee remarked from the hill above: \"It is well that war is so terrible, or we should grow too fond of it.\"\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        caption: \'The Truman Home in Independence\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
