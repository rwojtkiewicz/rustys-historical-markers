          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subtitle: \'The 22-Degree Turn Over the Mississippi\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Opened in 1929, this iconic 5,353-foot bridge carried Route 66 traffic over the Mississippi River. Famous for its unique 22-degree bend in the middle, engineered to allow river barges safe passage through treacherous bedrock rapids below.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
