          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        url: \'https://images.unsplash.com/photo-1555881400-74d7acaacd8b?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        caption: \'Dome of the Old Courthouse in Downtown St. Louis\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
