          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Completed in 1932 for $200,000, this open-spandrel concrete arch bridge spans 320 feet across Bixby Canyon, 260 feet above the crashing Pacific surf. Built during the Great Depression by the Civilian Conservation Corps, it opened the isolated Big Sur coastline to the world.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
