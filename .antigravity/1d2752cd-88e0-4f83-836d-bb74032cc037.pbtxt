          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Here at Adams Street & Michigan Avenue in downtown Chicago began U.S. Route 66 on November 11, 1926. Stretching 2,448 miles across eight states to Santa Monica, California, Route 66 became the main artery of Westward migration and American road culture.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    category: \'Aviation & Transit\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
