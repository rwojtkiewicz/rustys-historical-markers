          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        url: \'https://images.unsplash.com/photo-1569974498991-d3c12a504f9c?auto=format&fit=crop&w=1200&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        caption: \'Historic Steeple of Christ Church (Old North)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
