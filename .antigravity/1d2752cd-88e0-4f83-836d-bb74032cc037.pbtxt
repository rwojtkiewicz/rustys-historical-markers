          text: "    locationName: \'Fredericksburg Battlefield Center\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    city: \'Fredericksburg\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    state: \'VA\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    yearErected: 1927,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    markerNumber: \'VA-E-22\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    routeIds: [\'route-colonial-virginia\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
