          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plaqueText:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Founded in 1837 by the German School Society of Philadelphia to preserve German language and culture in North America. By the 1880s, Hermann\\\'s terraced Missouri River hills produced over 3 million gallons of wine annually, becoming one of the largest wine producing regions in the world.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
